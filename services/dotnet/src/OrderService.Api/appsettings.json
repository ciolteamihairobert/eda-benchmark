{
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "dotnet-order-service",
    "TopicOrdersPlaced": "orders.placed",
    "TopicOrdersProcessed": "orders.processed",
    "TopicOrdersFailed": "orders.failed"
  },
  "Fault": {
    "DelayMs": 0,
    "FailRate": 0.0
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Urls": "http://+:8080"
}
